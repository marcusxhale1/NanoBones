
<%- include("partials/header.ejs") %>

<div class="px-4 py-5 my-5 text-center"> <img class="d-block mx-auto img-fluid" src="Nano.png" alt="logo"
      width="500" height="500">
    <h1 class="display-5 fw-bold text-body-emphasis">Connecting Bay Area Families with Trusted Nannies</h1>
    <div class="col-lg-6 mx-auto">
      <p class="lead mb-4">Nano’s Nannies helps families find reliable childcare and helps nannies connect with quality
        opportunities that fit their experience and schedule.</p>
      <div class="d-grid gap-2 d-sm-flex justify-content-sm-center"> <button type="button"
          class="btn btn-primary btn-lg px-4 gap-3">Find a Nanny</button> <button type="button"
          class="btn btn-outline-secondary btn-lg px-4">Apply as a Nanny</button> </div>
    </div>
  </div>

  <div class="container col-xxl-8 px-4 py-5">
    <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
      <div class="col-10 col-sm-8 col-lg-6 mx-auto"> <img src="/Family.png"
          class="d-block mx-auto img-fluid" alt="Bootstrap Themes" width="700" height="500" loading="lazy"> </div>
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3 text-center text-lg-start">Family Care</h1>
        <p class="lead text-center text-lg-start">We strive to create a seamless and safe experience for families by
          thoughtfully vetting and matching them with trusted, high-quality nannies.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-start"> <button type="button"
            class="btn btn-primary btn-lg px-4 me-md-2">Find a Nanny</button>
        </div>
      </div>
    </div>
    <div class="row flex-lg-row align-items-center g-5 py-5">
      <div class="col-10 col-sm-8 col-lg-6 mx-auto"> <img src="/NannyChild.png"
          class="d-block mx-auto img-fluid" alt="Bootstrap Themes" width="700" height="500" loading="lazy"> </div>
      <div class="col-lg-6">
        <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3 text-center text-lg-start">For Nannies</h1>
        <p class="lead text-center text-lg-start">We strive to connect nannies with families who value their work by carefully matching
          each candidate with opportunities that fit their experience, schedule, and goals.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-start"> <button type="button"
            class="btn btn-primary btn-lg px-4 me-md-2">Find a Family</button>
        </div>
      </div>
    </div>

    <%- include("partials/footer.ejs") %>